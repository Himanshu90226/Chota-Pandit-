    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/ios": "8.6.0"
  }
}