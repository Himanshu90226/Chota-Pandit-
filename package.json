{
  "name": "akarra-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "AKARRA cross-platform mobile app",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "cap:add:android": "npm run prepare:web && cap add android",
